JWT_SECRET=
JWT_ALGORITHM=HS256

OWUI_BASE_URL=http://localhost:3000
OWUI_VERIFY_TLS=true

# sessions at a time; a package install briefly adds a 1 GiB microVM,
# so RAM up to this x (SANDBOX_MEMORY + 1 GiB)
MAX_CONCURRENT_SANDBOXES=10
MAX_CONCURRENT_SANDBOXES_PER_USER=1

RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

SANDBOX_IMAGE=owui-codebox-sandbox:latest
# per session microVM: memory in MiB, whole vCPUs
SANDBOX_MEMORY=2048
SANDBOX_CPUS=2
# timeouts in seconds, file size in bytes, output in characters
SANDBOX_EXEC_TIMEOUT=120
# how long a session waits for the next call
SANDBOX_IDLE_TIMEOUT=60
# lifetime of each microVM, bounds sessions and pip installs; keep above SANDBOX_EXEC_TIMEOUT
SANDBOX_MAX_DURATION=900
# per file; a run printing more than this is killed
SANDBOX_MAX_FILE_SIZE=52428800
# returned per stream, the rest is cut off
SANDBOX_MAX_OUTPUT=20000
SANDBOX_MAX_FILES=10
SANDBOX_MAX_PACKAGES=20
